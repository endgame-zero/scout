# PostgreSQL
POSTGRES_DB=newsdb
POSTGRES_USER=newsuser
POSTGRES_PASSWORD=newspass
DATABASE_URL=postgresql://newsuser:newspass@postgres:5432/newsdb

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# LLM (OpenAI-compatible)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_API_KEY=hf_your_key_here

# Embeddings
EMBEDDING_PROVIDER=huggingface
EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=hf_your_key_here
EMBEDDING_DIMENSIONS=384

# Ingestion
POLL_INTERVAL_SECONDS=300
KAFKA_TOPIC=raw-news
